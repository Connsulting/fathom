{
  "name": "fathom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"src/packs/test/*.test.mjs\" \"src/engine/test/*.test.mjs\" \"src/calc/test/*.test.mjs\" \"src/mcp/test/*.test.mjs\"",
    "seed:demo": "node demo/seed.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "smoke:live": "node --test src/engine/test/live.test.mjs",
    "build:your-plans": "node scripts/build-your-plans.mjs",
    "plan": "node src/jobs/plan-cli.mjs",
    "email:test": "node scripts/email-test.mjs",
    "confirm:guess": "node src/jobs/guess-cli.mjs",
    "user:invite": "node scripts/user-invite.mjs",
    "eval:ask": "node evals/run.mjs",
    "eval:ask:live": "node evals/run.mjs --live"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "14.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "nodemailer": "10.3.1",
    "pdfjs-dist": "6.4.299",
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
